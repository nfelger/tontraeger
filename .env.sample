# Copy this file to .env and adjust values for your setup.
# Component-specific settings live in server/.env and client/.env.

# ── Deploy targets (used by root Makefile) ──────────────
# SSH target for the server
SERVER_HOST=
# Directory on the server where the repo is deployed
SERVER_DIR=

# SSH target for the Raspberry Pi
PI_HOST=tontraeger.local

# Directory on the Pi where the client is deployed
PI_DIR=/home/pi/tontraeger

# Path to the `uv` binary on the Pi
PI_UV_BIN_DIR=/home/pi/.local/bin

# User and group for the systemd service on the Pi
PI_USER=pi
PI_GROUP=pi
