# Copy this file to .env and adjust values for your setup.

# ── Server ───────────────────────────────────────────────
# Default Sonos speaker name
SONOS_SPEAKER_NAME=Wohnzimmer

# ── Client (Pi) ──────────────────────────────────────────
# SSH target for the Raspberry Pi
PI_HOST=pi@tontraeger.local

# Directory on the Pi where the client is deployed
PI_DIR=/home/pi/tontraeger

# Server URL the client connects to
TONTRAEGER_SERVER=http://tontraeger.local:5000

# Path to local mapping cache on the Pi
TONTRAEGER_CACHE_PATH=/home/pi/tontraeger/client/mappings.json
