# Copy this file to .env and adjust values for your setup.

# Default Sonos speaker name
SONOS_SPEAKER_NAME=Wohnzimmer

# Server URL the client connects to
TONTRAEGER_SERVER=http://tontraeger.local:5000

# Path to local mapping cache
TONTRAEGER_CACHE_PATH=mappings.json

# Path to the NFC daemon binary
NFC_DAEMON_PATH=/usr/local/bin/nfc-daemon
